{
  "name": "leetcode-backend",
  "version": "1.0.0",
  "description": "Backend API for LeetCode clone",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "ts-node src/database/migrate.ts",
